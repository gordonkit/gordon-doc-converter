{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open documentation (English)",
      "type": "pwa-chrome",
      "request": "launch",
      "file": "${workspaceFolder}/docs/index.html",
      "presentation": {
        "group": "documentation",
        "order": 1
      }
    },
    {
      "name": "Open documentation (繁體中文)",
      "type": "pwa-chrome",
      "request": "launch",
      "file": "${workspaceFolder}/docs/index.zh-TW.html",
      "presentation": {
        "group": "documentation",
        "order": 2
      }
    }
  ]
}
