{
  "name": "gordon-doc-converter-docs",
  "private": true,
  "scripts": {
    "dev": "vite --config docs-src/vite.config.ts",
    "licenses:export": "uv run python scripts/export_third_party_notices.py",
    "licenses:check": "uv run python scripts/export_third_party_notices.py --check",
    "openapi:export": "uv run python scripts/export_openapi.py",
    "openapi:check": "uv run python scripts/export_openapi.py --check",
    "build": "npm run licenses:export && npm run openapi:export && vite build --config docs-src/vite.config.ts",
    "preview": "vite preview --config docs-src/vite.config.ts"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "react": "19.1.1",
    "react-dom": "19.2.8",
    "swagger-ui-dist": "5.32.14"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.0.2",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vite": "8.2.2"
  }
}
