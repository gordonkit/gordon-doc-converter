{
  "name": "gordon-doc-converter-docs",
  "private": true,
  "scripts": {
    "dev": "vite --config docs-src/vite.config.ts",
    "openapi:export": "uv run python scripts/export_openapi.py",
    "openapi:check": "uv run python scripts/export_openapi.py --check",
    "build": "npm run openapi:export && vite build --config docs-src/vite.config.ts",
    "preview": "vite preview --config docs-src/vite.config.ts"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "swagger-ui-dist": "5.32.13"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vite": "8.2.1"
  }
}
