FROM python:3.12-slim AS builder

WORKDIR /build
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip wheel --no-cache-dir --wheel-dir /wheels .

FROM python:3.12-slim

LABEL org.opencontainers.image.licenses="Apache-2.0" \
    org.opencontainers.image.source="https://github.com/gordonkit/gordon-doc-converter"

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install --no-install-recommends -y libreoffice-writer fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 gordon
COPY --from=builder /wheels /wheels
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.txt /usr/share/licenses/gordon-doc-converter/
RUN pip install --no-cache-dir /wheels/* && rm -rf /wheels
USER gordon
WORKDIR /work
ENV PYTHONDONTWRITEBYTECODE=1 HOME=/home/gordon
ENTRYPOINT ["gordon-doc"]
